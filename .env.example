# ── aomi backend ──────────────────────────────────────────────────────
# Everything here is NEXT_PUBLIC_ on purpose. This app is open source and has
# no server, so it holds no secret — and it no longer needs one. Requests are
# authorized by a signature from the account owner's own wallet, which is
# strictly narrower than the platform bearer this demo used to hide: a leaked
# signature authorizes one action on one handover, where the bearer authorized
# every user of the venue.
#
# There is deliberately no AOMI_PLATFORM_TOKEN. If you find yourself wanting
# one here, the design has gone wrong.

NEXT_PUBLIC_AOMI_BACKEND_URL=https://api-staging.aomi.dev

# The platform, as it appears in /api/platforms/:name/... — this is the
# *platform*, not the application. They differ: the app is `world-markets`.
NEXT_PUBLIC_AOMI_PLATFORM_NAME=world-market-apps

# The Telegram bot registration handovers hang off. Safe to publish: the
# backend pins the bot from its own venue config and refuses a request that
# names a different one.
NEXT_PUBLIC_AOMI_BOT_REGISTRATION_ID=

# ── venue ─────────────────────────────────────────────────────────────
# The partner runs three deployments, two of them live with the same ABI, so a
# wrong value here fails silently rather than loudly:
#
#   dev.wcm.inc      chain 2092151908 (Puffer UniFi)  0xf6b54e03…   <- this app
#   staging.wcm.inc  chain 4326       (MegaETH)       0x5e3Ae52E…
#   world.inc        production                       not yet known
NEXT_PUBLIC_VENUE_RPC_URL=https://testnet-unifi-rpc.puffer.fi/
NEXT_PUBLIC_VENUE_EXCHANGE_ADDRESS=0xf6b54e033bb45a583aa642924bcef78b804588ae

# The origin the backend pins SIWE signatures to. Compared byte-exactly, so it
# must match window.location.origin — no trailing slash.
NEXT_PUBLIC_VENUE_ORIGIN=https://dev.wcm.inc
