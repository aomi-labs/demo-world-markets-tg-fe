# ── aomi backend ──────────────────────────────────────────────────────
# Base URL of the aomi backend serving the platform API.
AOMI_BACKEND_URL=https://api.staging.aomi.dev

# Your platform's name, as it appears in /api/platforms/:name/...
AOMI_PLATFORM_NAME=world-markets

# Platform activation bearer. SERVER-ONLY — this authorizes issuing and
# revoking handovers for every bot your platform owns. Never expose it to the
# browser, never prefix it with NEXT_PUBLIC_.
AOMI_PLATFORM_TOKEN=

# The Telegram bot registration handovers are issued against.
AOMI_BOT_REGISTRATION_ID=

# ── venue ─────────────────────────────────────────────────────────────
# Public: read by the browser to send the grant transaction.
NEXT_PUBLIC_VENUE_EXCHANGE_ADDRESS=0x5e3Ae52EbA0F9740364Bd5dd39738e1336086A8b
NEXT_PUBLIC_MEGAETH_RPC_URL=https://carrot.megaeth.com/rpc
